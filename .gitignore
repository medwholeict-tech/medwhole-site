# dependencies
/node_modules
/.pnpm-store/

# next.js
/.next/
/.next-build/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.next-dev.*.log

# env files
.env*

# vercel
.vercel

# cloudflare
/.open-next/
/.wrangler/
