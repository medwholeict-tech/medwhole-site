{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medwhole-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXTAUTH_URL": "https://medwhole-website.medwhole.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://www.medwhole.org",
    "NEXT_PUBLIC_SITE_URL": "https://www.medwhole.org",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "zouo3v31",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY": "public_NlUSbegVr9G2frZZqSyYpkGhKpA=",
    "NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/medwhole",
    "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION": "your-google-verification-code",
    "EMAIL_FROM": "info@medwhole.org",
    "PAYLOAD_CMS_URL": "https://medwhole-cms.medwhole.workers.dev",
    "PAYLOAD_CMS_PUBLIC_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
