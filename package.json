{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19"
    }
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest",
    "verify": "vitest run && next build",
    "deploy:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "cms:dev": "pnpm --dir cms dev",
    "cms:build": "pnpm --dir cms build",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs && wrangler dev",
    "cf:deploy": "node scripts/cf-build.mjs && node scripts/cf-deploy.mjs website",
    "cf:deploy:built": "node scripts/cf-deploy.mjs website",
    "cms:media-upload-neon": "pnpm exec tsx cms/scripts/upload-media-to-neon.ts",
    "cms:migrate-content": "node --env-file=cms/.env.local scripts/migrations/payload-only-data.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@vercel/analytics": "latest",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.2",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "8.5.1",
    "imagekit": "^6.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.454.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.60.0",
    "resend": "^6.6.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.11.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^1.6.1",
    "wrangler": "^4.155.0"
  }
}
