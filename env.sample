# Copy to .env.local. Values here are placeholders; never use production databases locally.
DATABASE_URL=postgresql://website_user:replace-me@localhost:5432/medwhole_website
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-the-same-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_DIST_DIR=.next
ADMIN_EMAIL=admin@example.com

PAYLOAD_CMS_URL=http://localhost:3100
PAYLOAD_CMS_PUBLIC_ENABLED=true
PAYLOAD_CMS_READ_API_KEY=
PAYLOAD_CMS_ADMIN_API_KEY=
PAYLOAD_CMS_OPERATIONS_API_KEY=
PAYLOAD_CMS_FINANCE_API_KEY=
PAYLOAD_CMS_WEBSITE_API_KEY=

# Optional notification and payment integrations
RESEND_API_KEY=
EMAIL_FROM=info@example.com
PAYSTACK_SECRET_KEY=
# Optional ImageKit helper
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
