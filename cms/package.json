{
  "name": "medwhole-cms",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "cf:build": "node ../scripts/cf-build.mjs cms",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "pnpm cf:build && node ../scripts/cf-deploy.mjs cms",
    "cf:deploy:skip-build": "node ../scripts/cf-deploy.mjs cms"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@smithy/fetch-http-handler": "^5.8.0",
    "graphql": "^16.14.2",
    "jose": "5.10.0",
    "next": "15.4.11",
    "payload": "3.91.0",
    "pg-cloudflare": "1.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.11.0",
    "@swc-node/register": "^1.12.1",
    "wrangler": "4.155.0"
  }
}
