# Production: https://cms.medwhole.org
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3100
# Optional previous public hostname; redirects to PAYLOAD_PUBLIC_SERVER_URL.
PAYLOAD_PREVIOUS_HOST=
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://medwhole_payload:replace-me@your-neon-host/medwhole_payload?sslmode=require
# Enable only for disposable local development databases. Use migrations on Neon.
PAYLOAD_DB_PUSH=false
PAYLOAD_CORS_ORIGINS=http://localhost:3000
PAYLOAD_CSRF_ORIGINS=http://localhost:3100,http://localhost:3000

# Optional durable media storage. Provision a Neon Object Storage bucket before
# setting S3_BUCKET. Without it, Payload uses local filesystem storage.
S3_BUCKET=medwhole
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
